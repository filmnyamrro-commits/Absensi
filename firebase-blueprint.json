{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized trainer or administrator account UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the administrator.",
          "minLength": 5,
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "description": "Full name of the administrator.",
          "minLength": 1,
          "maxLength": 120
        },
        "addedBy": {
          "type": "string",
          "description": "UID of the admin who granted access.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted."
        }
      },
      "required": ["uid", "email", "displayName", "addedBy", "createdAt"]
    },
    "AdminEmailInvite": {
      "title": "AdminEmailInvite",
      "description": "Authorized Gmail or work email address allowed to access the trainer dashboard.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Sanitized lowercase email key matching ^[a-z0-9_]+$.",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[a-z0-9_]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Invited Gmail or work email address.",
          "minLength": 5,
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "description": "Trainer or coordinator display name.",
          "minLength": 1,
          "maxLength": 120
        },
        "addedBy": {
          "type": "string",
          "description": "UID of the admin who invited this email.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when email invite was created."
        }
      },
      "required": ["id", "email", "displayName", "addedBy", "createdAt"]
    },
    "ForumEvent": {
      "title": "ForumEvent",
      "description": "A school seminar, workshop, training session, or forum event.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the event.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Title of the seminar, workshop, or forum.",
          "minLength": 2,
          "maxLength": 160
        },
        "eventDate": {
          "type": "string",
          "description": "Date of the event in YYYY-MM-DD format.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "location": {
          "type": "string",
          "description": "Venue or campus location of the event.",
          "minLength": 2,
          "maxLength": 160
        },
        "locationAddress": {
          "type": "string",
          "description": "Optional formatted street address from Google Places.",
          "minLength": 0,
          "maxLength": 300
        },
        "locationLat": {
          "type": "number",
          "description": "Optional latitude coordinate for the event venue."
        },
        "locationLng": {
          "type": "number",
          "description": "Optional longitude coordinate for the event venue."
        },
        "description": {
          "type": "string",
          "description": "Brief summary of the event agenda or audience.",
          "minLength": 0,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "Whether participant registration is currently Open or Closed.",
          "enum": ["Open", "Closed"]
        },
        "createdBy": {
          "type": "string",
          "description": "Firebase Auth UID of the creator admin.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when event was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when event was last updated."
        }
      },
      "required": [
        "id",
        "title",
        "eventDate",
        "location",
        "description",
        "status",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "ParticipantRegistration": {
      "title": "ParticipantRegistration",
      "description": "Attendance record and photo reference for a participant in a specific forum event.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Deterministic registration ID preventing duplicate submissions for the same event.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventId": {
          "type": "string",
          "description": "Parent ForumEvent ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantNumber": {
          "type": "string",
          "description": "Formatted participant reference number (e.g. SGM-20261115-A4F2).",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Participant full name.",
          "minLength": 2,
          "maxLength": 120
        },
        "className": {
          "type": "string",
          "description": "Participant class or homeroom/role.",
          "minLength": 1,
          "maxLength": 60
        },
        "level": {
          "type": "string",
          "description": "School level (e.g. Primary, Secondary, Early Years, or other).",
          "minLength": 2,
          "maxLength": 60
        },
        "schoolDistrict": {
          "type": "string",
          "description": "Sekolah Global Mandiri campus/district.",
          "enum": [
            "Sekolah Global Mandiri Cibubur",
            "Sekolah Global Mandiri Jakarta",
            "Sekolah Global Mandiri Palembang"
          ]
        },
        "photoStoragePath": {
          "type": "string",
          "description": "Firebase Storage object path for the participant photo.",
          "minLength": 10,
          "maxLength": 512
        },
        "consentAccepted": {
          "type": "boolean",
          "description": "Explicit participant consent for workshop attendance documentation."
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp automatically recorded on submission."
        }
      },
      "required": [
        "id",
        "eventId",
        "participantNumber",
        "fullName",
        "className",
        "level",
        "schoolDistrict",
        "photoStoragePath",
        "consentAccepted",
        "registeredAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Authorized trainer/admin accounts by UID."
    },
    "/adminEmails/{emailKey}": {
      "schema": { "$ref": "#/entities/AdminEmailInvite" },
      "description": "Authorized trainer/admin Gmail and work email addresses."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/ForumEvent" },
      "description": "School forum, seminar, and workshop events."
    },
    "/events/{eventId}/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/ParticipantRegistration" },
      "description": "Event-isolated participant attendance records."
    }
  }
}
